---
import { education } from "../data/site";
---

<div class="space-y-3">
  {education.map((e) => (
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="font-display text-[15px] font-semibold text-ink">{e.school}</h3>
          <p class="mt-0.5 text-[14px] text-slate-600">{e.degree}</p>
        </div>
        <span class:list={[
          "shrink-0 rounded-full px-2.5 py-1 text-[11px]",
          e.current ? "bg-green-50 text-green-700 ring-1 ring-green-200" : "bg-slate-100 text-slate-600"
        ]}>{e.period}</span>
      </div>
      <p class="mt-2 text-[13px] text-slate-500">{e.detail}</p>
    </div>
  ))}
</div>
