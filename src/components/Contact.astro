---
import { site } from "../data/site";
---

<section class="mb-12 rounded-2xl border border-slate-200 bg-ink p-6 text-center sm:p-8">
  <h2 class="text-xl font-bold tracking-tight text-white">Let's connect</h2>
  <p class="mx-auto mt-2 max-w-sm text-[14px] leading-relaxed text-slate-300">
    First-year CSE student open to internships, open source and learning together. My inbox is always open.
  </p>
  <div class="mt-5 flex items-center justify-center gap-3">
    <a href={`mailto:${site.email}`} class="rounded-full bg-white px-5 py-2 text-[14px] font-medium text-ink transition hover:bg-slate-200">
      Say hello
    </a>
    <button id="copy-email" data-email={site.email} class="rounded-full border border-white/20 px-5 py-2 text-[14px] text-white transition hover:bg-white/10">
      Copy email
    </button>
  </div>
  <p class="mt-3 text-[12px] text-slate-400">{site.email}</p>
</section>

<script>
  const btn = document.getElementById('copy-email');
  btn?.addEventListener('click', async () => {
    const email = (btn as HTMLElement).dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
      const orig = btn.textContent;
      btn.textContent = 'Copied ✓';
      setTimeout(() => (btn.textContent = orig), 1500);
    } catch {}
  });
</script>
