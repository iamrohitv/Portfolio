---
import type { Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  href={project.live}
  target="_blank"
  rel="noreferrer"
  class="group block rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.06)]"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-[16px] font-semibold tracking-tight text-ink">
      {project.title}
      <span class="ml-1 inline-block text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-ink">↗</span>
    </h3>
    {project.badge && (
      <span class:list={[
        "shrink-0 rounded-full px-2.5 py-1 text-[11px] font-medium",
        project.featured ? "bg-ink text-white" : "bg-slate-100 text-slate-600"
      ]}>{project.badge}</span>
    )}
  </div>
  <p class="mt-2 text-[14px] leading-relaxed text-slate-600">{project.description}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {project.tech.map((t) => (
      <span class="rounded-md bg-slate-50 px-2 py-0.5 text-[12px] text-slate-600 ring-1 ring-slate-200/60">{t}</span>
    ))}
  </div>
  <div class="mt-3 flex items-center gap-3 text-[13px]">
    <span class="text-slate-500">{project.liveLabel}</span>
    <span class="text-slate-300">·</span>
    <span class="text-slate-500 underline-offset-2 group-hover:underline" data-github={project.github}>GitHub →</span>
  </div>
</a>

<script>
  // Make GitHub link clickable without nesting <a> tags
  document.querySelectorAll('[data-github]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const url = (el as HTMLElement).dataset.github;
      if (url) window.open(url, '_blank', 'noopener');
    });
  });
</script>
