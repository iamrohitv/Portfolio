---
import { site } from "../data/site";
---

<div class="-mt-[16px] flex flex-col gap-1.5">
  <p class="text-sm text-slate-600">GitHub contributions over the last year.</p>
</div>

<!-- Desktop: single row like the original -->
<div id="activity-desktop" class="hidden sm:block" data-handle={site.githubHandle}></div>

<!-- Phone: carousel heatmap, one slide at a time with arrows + dots -->
<div class="sm:hidden">
  <div id="activity-viewport" class="overflow-hidden">
    <div id="activity-track" class="flex transition-transform duration-300 ease-out"></div>
  </div>
  <div class="mt-2 flex items-center justify-center">
    <div id="activity-dots" class="flex items-center gap-1.5" aria-hidden="true"></div>
  </div>
</div>

<div class="mt-3 flex items-center gap-1.5 font-serif text-xs text-slate-500">
  <span>less</span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-100"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-300"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-400"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-600"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-ink"></span>
  <span>more</span>
</div>

<script>
  const LEVEL_CLASSES = ["bg-zinc-100", "bg-zinc-300", "bg-zinc-400", "bg-zinc-600", "bg-ink"];
  const CELL_BASE = "aspect-square w-full rounded-[2px]";
  const TOTAL_WEEKS = 53;
  const DAYS = 7;
  const TOTAL_DAYS = TOTAL_WEEKS * DAYS;

  function mulberry32(seed: number) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  type Entry = { date: string | null; count: number; level: number };

  function seededEntries(): Entry[] {
    const rand = mulberry32(20260214);
    const out: Entry[] = [];
    const today = new Date();
    for (let i = 0; i < TOTAL_DAYS; i++) {
      const r = rand();
      const burst = rand() > 0.93 ? 1 : 0;
      const level = r < 0.38 ? 0 : r < 0.62 ? 1 : r < 0.8 ? 2 : r < 0.93 ? 3 : 4;
      const d = new Date(today);
      d.setDate(today.getDate() - (TOTAL_DAYS - 1 - i));
      const date = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      const count = level === 0 ? 0 : level + burst + Math.floor(rand() * (level * 3));
      out.push({ date, count, level });
    }
    return out;
  }

  function monthShort(dateStr: string): string {
    return new Date(dateStr + "T00:00:00").toLocaleString("en-US", { month: "short" });
  }

  function uniqueMonths(entries: Entry[]): string[] {
    const out: string[] = [];
    for (const e of entries) {
      if (!e.date) continue;
      const m = monthShort(e.date);
      if (out[out.length - 1] !== m) out.push(m);
    }
    return out;
  }

  function titleFor(e: Entry): string {
    if (!e.date || e.count === 0) return e.date ? `No activity on ${e.date}` : "No activity";
    return `${e.count} contribution${e.count === 1 ? "" : "s"} on ${e.date}`;
  }

  function cellDiv(e: Entry): HTMLDivElement {
    const div = document.createElement("div");
    const level = Math.min(4, Math.max(0, e.level ?? 0));
    div.className = `${CELL_BASE} ${LEVEL_CLASSES[level]}`;
    div.title = titleFor(e);
    return div;
  }

  function weekDiv(week: Entry[]): HTMLDivElement {
    const w = document.createElement("div");
    w.className = "flex min-w-0 flex-col gap-[3px]";
    week.forEach((e) => w.appendChild(cellDiv(e)));
    return w;
  }

  // Invisible placeholder column: holds grid space so short slides keep
  // identical box sizes, but never reads as data.
  function blankWeekDiv(): HTMLDivElement {
    const w = document.createElement("div");
    w.className = "flex min-w-0 flex-col gap-[3px]";
    w.setAttribute("aria-hidden", "true");
    for (let i = 0; i < DAYS; i++) {
      const c = document.createElement("div");
      c.className = `${CELL_BASE} pointer-events-none bg-zinc-100/40`;
      w.appendChild(c);
    }
    return w;
  }

  function monthRow(months: string[]): HTMLDivElement {
    const r = document.createElement("div");
    r.className = "flex w-full justify-between font-serif text-[11px] text-slate-400";
    r.setAttribute("aria-hidden", "true");
    months.forEach((m) => {
      const s = document.createElement("span");
      s.textContent = m;
      r.appendChild(s);
    });
    return r;
  }

  function gridEl(weekCount: number): HTMLDivElement {
    const g = document.createElement("div");
    g.className = "mt-1 grid w-full gap-[3px]";
    g.style.gridTemplateColumns = `repeat(${weekCount}, minmax(0, 1fr))`;
    return g;
  }

  let carouselIndex = 0;
  let carouselBound = false;

  function goToSlide(i: number): void {
    const trackEl = document.getElementById("activity-track");
    if (!trackEl) return;
    const total = trackEl.childElementCount;
    if (!total) return;
    carouselIndex = Math.min(Math.max(0, i), total - 1);
    trackEl.style.transform = `translateX(-${carouselIndex * 100}%)`;
    paintDots();
  }

  function paintDots(): void {
    const dotsWrap = document.getElementById("activity-dots");
    const trackEl = document.getElementById("activity-track");
    if (!dotsWrap || !trackEl) return;
    const total = trackEl.childElementCount;
    dotsWrap.replaceChildren();
    for (let i = 0; i < total; i++) {
      const d = document.createElement("button");
      d.type = "button";
      d.setAttribute("aria-label", `Go to slide ${i + 1}`);
      d.className = `h-1.5 w-1.5 rounded-full transition ${i === carouselIndex ? "bg-ink" : "bg-zinc-300"}`;
      d.addEventListener("click", () => goToSlide(i));
      dotsWrap.appendChild(d);
    }
  }

  function bindCarouselControls(): void {
    if (carouselBound) return;
    carouselBound = true;
    const viewport = document.getElementById("activity-viewport");
    let touchX: number | null = null;
    viewport?.addEventListener("touchstart", (e) => {
      touchX = e.touches[0].clientX;
    }, { passive: true });
    viewport?.addEventListener("touchend", (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      if (dx < -40) goToSlide(carouselIndex + 1);
      else if (dx > 40) goToSlide(carouselIndex - 1);
    }, { passive: true });
  }

  function render(entries: Entry[]) {
    const weeks: Entry[][] = [];
    for (let i = 0; i < TOTAL_WEEKS; i++) weeks.push(entries.slice(i * DAYS, i * DAYS + DAYS));

    // Desktop: one row of 53
    const desktop = document.getElementById("activity-desktop");
    if (desktop) {
      desktop.replaceChildren();
      desktop.appendChild(monthRow(uniqueMonths(entries)));
      const grid = gridEl(TOTAL_WEEKS);
      weeks.forEach((w) => grid.appendChild(weekDiv(w)));
      desktop.appendChild(grid);
    }

    // Phone carousel: 53 columns split into 3 near-equal slides, one
    // visible at a time (arrows + dots + touch swipe, no free scroll).
    // Phone lessons kept: equal-ratio columns via blank padding, per-slide
    // month labels from day-level dates, faded blanks, live data fallback.
    const track = document.getElementById("activity-track");
    if (track) {
      track.replaceChildren();
      const perSlide = Math.ceil(TOTAL_WEEKS / 3);
      const slides: Entry[][][] = [];
      for (let s = 0; s * perSlide < TOTAL_WEEKS; s++) {
        slides.push(weeks.slice(s * perSlide, s * perSlide + perSlide));
      }
      // Pad short slides with blank columns so every slide has the same
      // column count and all boxes stay identical in size.
      const maxCols = Math.max(...slides.map((s) => s.length), 0);
      slides.forEach((segWeeks) => {
        if (!segWeeks.length) return;
        const seg = document.createElement("div");
        seg.className = "w-full min-w-full shrink-0";
        seg.appendChild(monthRow(uniqueMonths(segWeeks.flat())));
        const grid = gridEl(maxCols);
        segWeeks.forEach((w) => grid.appendChild(weekDiv(w)));
        for (let p = segWeeks.length; p < maxCols; p++) {
          grid.appendChild(blankWeekDiv());
        }
        seg.appendChild(grid);
        track.appendChild(seg);
      });
      bindCarouselControls();
      goToSlide(carouselIndex);
    }
  }

  // Render instantly so there is no empty flash, then try real GitHub data.
  render(seededEntries());

  const desktop = document.getElementById("activity-desktop");
  const handle = desktop?.dataset.handle ?? "iamrohitv";

  fetch(`https://github-contributions-api.jogruber.de/v4/${handle}?y=last`)
    .then((res) => (res.ok ? res.json() : Promise.reject()))
    .then((data) => {
      const list = (data?.contributions ?? []) as Array<{ date: string; count: number; level: number }>;
      if (!list.length) return;
      const slice = list.slice(-TOTAL_DAYS);
      const entries: Entry[] = slice.map((c) => ({ date: c.date, count: c.count ?? 0, level: c.level ?? 0 }));
      while (entries.length < TOTAL_DAYS) entries.unshift({ date: null, count: 0, level: 0 });
      render(entries);
    })
    .catch(() => {
      // Seeded pattern stays when the API is unreachable.
    });
</script>
