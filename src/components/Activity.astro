---
import { site } from "../data/site";
---

<div class="flex flex-col gap-1.5">
  <p class="text-sm text-slate-600">GitHub contributions over the last year.</p>
</div>

<!-- Desktop: single row like the original -->
<div id="activity-desktop" class="hidden sm:block" data-handle={site.githubHandle}></div>

<!-- Phone: three equal swipeable segments, each with its own months -->
<div id="activity-mobile" class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 sm:hidden"></div>

<div class="mt-3 flex items-center gap-1.5 font-mono text-xs text-slate-500">
  <span>less</span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-100"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-300"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-400"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-600"></span>
  <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-800"></span>
  <span>more</span>
</div>

<script>
  const LEVEL_CLASSES = ["bg-zinc-100", "bg-zinc-300", "bg-zinc-400", "bg-zinc-600", "bg-zinc-800"];
  const CELL_BASE = "aspect-square w-full rounded-[2px]";
  const TOTAL_WEEKS = 53;
  const DAYS = 7;
  const TOTAL_DAYS = TOTAL_WEEKS * DAYS;
  const SEGMENT_WEEKS = [18, 18, 17];

  function mulberry32(seed: number) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  type Entry = { date: string | null; count: number; level: number };

  function seededEntries(): Entry[] {
    const rand = mulberry32(20260214);
    const out: Entry[] = [];
    const today = new Date();
    for (let i = 0; i < TOTAL_DAYS; i++) {
      const r = rand();
      const burst = rand() > 0.93 ? 1 : 0;
      const level = r < 0.38 ? 0 : r < 0.62 ? 1 : r < 0.8 ? 2 : r < 0.93 ? 3 : 4;
      const d = new Date(today);
      d.setDate(today.getDate() - (TOTAL_DAYS - 1 - i));
      const date = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      const count = level === 0 ? 0 : level + burst + Math.floor(rand() * (level * 3));
      out.push({ date, count, level });
    }
    return out;
  }

  function monthShort(dateStr: string): string {
    return new Date(dateStr + "T00:00:00").toLocaleString("en-US", { month: "short" });
  }

  function uniqueMonths(entries: Entry[]): string[] {
    const out: string[] = [];
    for (const e of entries) {
      if (!e.date) continue;
      const m = monthShort(e.date);
      if (out[out.length - 1] !== m) out.push(m);
    }
    return out;
  }

  function titleFor(e: Entry): string {
    if (!e.date || e.count === 0) return e.date ? `No activity on ${e.date}` : "No activity";
    return `${e.count} contribution${e.count === 1 ? "" : "s"} on ${e.date}`;
  }

  function cellDiv(e: Entry): HTMLDivElement {
    const div = document.createElement("div");
    const level = Math.min(4, Math.max(0, e.level ?? 0));
    div.className = `${CELL_BASE} ${LEVEL_CLASSES[level]}`;
    div.title = titleFor(e);
    return div;
  }

  function weekDiv(week: Entry[]): HTMLDivElement {
    const w = document.createElement("div");
    w.className = "flex min-w-0 flex-col gap-[3px]";
    week.forEach((e) => w.appendChild(cellDiv(e)));
    return w;
  }

  function monthRow(months: string[]): HTMLDivElement {
    const r = document.createElement("div");
    r.className = "flex w-full justify-between font-mono text-[11px] text-slate-400";
    r.setAttribute("aria-hidden", "true");
    months.forEach((m) => {
      const s = document.createElement("span");
      s.textContent = m;
      r.appendChild(s);
    });
    return r;
  }

  function gridEl(weekCount: number): HTMLDivElement {
    const g = document.createElement("div");
    g.className = "mt-1 grid w-full gap-[3px]";
    g.style.gridTemplateColumns = `repeat(${weekCount}, minmax(0, 1fr))`;
    return g;
  }

  function render(entries: Entry[]) {
    const weeks: Entry[][] = [];
    for (let i = 0; i < TOTAL_WEEKS; i++) weeks.push(entries.slice(i * DAYS, i * DAYS + DAYS));

    // Desktop: one row of 53
    const desktop = document.getElementById("activity-desktop");
    if (desktop) {
      desktop.replaceChildren();
      desktop.appendChild(monthRow(uniqueMonths(entries)));
      const grid = gridEl(TOTAL_WEEKS);
      weeks.forEach((w) => grid.appendChild(weekDiv(w)));
      desktop.appendChild(grid);
    }

    // Phone: three equal stacked segments, each with its own months
    const mobile = document.getElementById("activity-mobile");
    if (mobile) {
      mobile.replaceChildren();
      let offset = 0;
      SEGMENT_WEEKS.forEach((count) => {
        const segWeeks = weeks.slice(offset, offset + count);
        offset += count;
        const seg = document.createElement("div");
        seg.className = "flex w-full min-w-full shrink-0 snap-center flex-col";
        seg.appendChild(monthRow(uniqueMonths(segWeeks.flat())));
        const grid = gridEl(count);
        segWeeks.forEach((w) => grid.appendChild(weekDiv(w)));
        seg.appendChild(grid);
        mobile.appendChild(seg);
      });
    }
  }

  // Render instantly so there is no empty flash, then try real GitHub data.
  render(seededEntries());

  const desktop = document.getElementById("activity-desktop");
  const handle = desktop?.dataset.handle ?? "iamrohitv";

  fetch(`https://github-contributions-api.jogruber.de/v4/${handle}?y=last`)
    .then((res) => (res.ok ? res.json() : Promise.reject()))
    .then((data) => {
      const list = (data?.contributions ?? []) as Array<{ date: string; count: number; level: number }>;
      if (!list.length) return;
      const slice = list.slice(-TOTAL_DAYS);
      const entries: Entry[] = slice.map((c) => ({ date: c.date, count: c.count ?? 0, level: c.level ?? 0 }));
      while (entries.length < TOTAL_DAYS) entries.unshift({ date: null, count: 0, level: 0 });
      render(entries);
    })
    .catch(() => {
      // Seeded pattern stays when the API is unreachable.
    });
</script>
