---
interface Props {
  title: string;
  link?: string;
  linkLabel?: string;
}
const { title, link, linkLabel } = Astro.props;
---

<div class="mb-4 flex items-baseline justify-between">
  <h2 class="font-display text-sm uppercase tracking-wider text-slate-500">{title}</h2>
  {link && <a href={link} class="font-serif text-[13px] text-slate-500 hover:text-ink">{linkLabel ?? "all →"}</a>}
</div>
