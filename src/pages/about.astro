---
import Base from "../layouts/Base.astro";
import Education from "../components/Education.astro";
import Skills from "../components/Skills.astro";
import { site } from "../data/site";
---

<Base title="About - Rohit Verma" description="About Rohit Verma, BTech CSE student at YCCE Nagpur.">
  <section class="pb-8 pt-10">
    <div class="flex items-center gap-4">
      <img src={site.avatar} alt={site.name} class="h-16 w-16 rounded-full border border-slate-200 object-cover" />
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950">About me</h1>
        <p class="text-[14px] text-slate-500">{site.role} · Born June 2008</p>
      </div>
    </div>

    <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-slate-600">
      <p>
        Hey, I am <span class="font-medium text-slate-900">Rohit Verma</span>, a first-year BTech CSE student at
        <span class="font-medium text-slate-900"> YCCE Nagpur (2026-2030)</span>. I got into coding because I love
        building things people can actually click and use.
      </p>
      <p>
        My major project is <span class="font-medium text-slate-900">Skarm</span>, an issue-tracking platform
        (Kanban, AI triage, workspaces) I forked and am learning from, and
        <span class="font-medium text-slate-900"> Hexlab</span>, a SaaS landing page where I practiced
        Next.js 15, Tailwind v4 and buttery animations.
      </p>
      <p>
        Schooling: Class 10th from <span class="font-medium text-slate-900">Carmel Academy (86.5%)</span> and
        Class 12th from <span class="font-medium text-slate-900">St. Paul Jr. College (72.5%)</span>.
      </p>
    </div>

    <div class="mt-6 flex gap-3">
      <a href={`mailto:${site.email}`} class="rounded-full bg-slate-950 px-5 py-2 text-[14px] font-medium text-white hover:bg-slate-800">Hire / hello</a>
      <a href={site.github} target="_blank" rel="noreferrer" class="rounded-full border border-slate-200 px-5 py-2 text-[14px] text-slate-700 hover:border-slate-900">GitHub ↗</a>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="mb-4 font-mono text-sm uppercase tracking-wider text-slate-500">Education</h2>
    <Education />
  </section>

  <section class="mb-12">
    <h2 class="mb-4 font-mono text-sm uppercase tracking-wider text-slate-500">Skills</h2>
    <Skills />
  </section>
</Base>
