---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} - ${site.role}`, description = site.bio } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="bg-white text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`https://github.com/${site.githubHandle}.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen overflow-x-clip bg-white text-slate-900 antialiased">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur">
      <nav class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-6 py-5 sm:py-8">
        <a href="/" class="font-mono text-sm text-slate-900 hover:text-slate-500">
          {site.shortName}
        </a>
        <div class="flex items-center gap-3 font-mono text-sm text-slate-500 sm:gap-4">
          <a href="/projects" class:list={["hover:text-slate-950", currentPath === "/projects" && "text-slate-950"]}>Projects</a>
          <a href="/about" class:list={["hover:text-slate-950", currentPath === "/about" && "text-slate-950"]}>About</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto flex max-w-2xl flex-col gap-4 px-6">
      <slot />
    </main>

    <footer class="mx-auto max-w-2xl px-6 pb-10 pt-8">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-slate-100 pt-6 text-[13px] text-slate-500">
        <span>© 2026 {site.name}</span>
        <div class="flex gap-4">
          <a href={site.github} target="_blank" rel="noreferrer" class="hover:text-slate-900">GitHub</a>
          <a href={`mailto:${site.email}`} class="hover:text-slate-900">Email</a>
          <a href="/" class="hover:text-slate-900">Top ↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>
