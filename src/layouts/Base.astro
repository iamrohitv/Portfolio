---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} - ${site.role}`, description = site.bio } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="bg-white text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`https://github.com/${site.githubHandle}.png`} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS Feed`} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen overflow-x-clip bg-white text-slate-900 antialiased">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur">
      <nav class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-6 py-5 sm:py-8">
        <a href="/" class="font-mono text-sm text-slate-900 hover:text-slate-500">
          {site.shortName}
        </a>
        <div class="flex items-center gap-3 font-mono text-sm text-slate-500 sm:gap-4">
          <a href="/projects" class:list={["hover:text-slate-950", currentPath === "/projects" && "text-slate-950"]}>Projects</a>
          <a href="/about" class:list={["hover:text-slate-950", currentPath === "/about" && "text-slate-950"]}>About</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto flex max-w-2xl flex-col gap-4 px-6">
      <slot />
    </main>

    <footer class="mx-auto max-w-2xl px-6 pb-10 pt-8">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-slate-100 pt-6 text-[13px] text-slate-500">
        <span>© 2026 {site.name}</span>
        <div class="flex gap-4">
          <a href={site.github} target="_blank" rel="noreferrer" class="hover:text-slate-900">GitHub</a>
          <a href={`mailto:${site.email}`} class="hover:text-slate-900">Email</a>
          <a href="/" class="hover:text-slate-900">Top ↑</a>
        </div>
      </div>
    </footer>

    <div
      id="scrollbar-thumb"
      aria-hidden="true"
      class="fixed right-0 top-0 z-[100] hidden w-1 cursor-grab rounded-full active:cursor-grabbing"
      style="height: 3cm; background: rgba(112, 112, 112, 0.35);"
    ></div>

    <script>
      const thumb = document.getElementById("scrollbar-thumb");
      const root = document.documentElement;

      function maxScroll(): number {
        return root.scrollHeight - root.clientHeight;
      }

      function updateThumb(): void {
        if (!thumb) return;
        const max = maxScroll();
        if (max <= 0) {
          thumb.style.display = "none";
          return;
        }
        const travel = Math.max(0, root.clientHeight - thumb.offsetHeight);
        const y = (root.scrollTop / max) * travel;
        thumb.style.display = "block";
        thumb.style.transform = `translateY(${y}px)`;
      }

      // Drag the thumb to scroll, like a native scrollbar.
      let dragging = false;
      let dragOffset = 0;
      thumb?.addEventListener("mousedown", (e) => {
        dragging = true;
        dragOffset = e.clientY - (thumb as HTMLElement).getBoundingClientRect().top;
        document.body.style.userSelect = "none";
        e.preventDefault();
      });
      window.addEventListener("mousemove", (e) => {
        if (!dragging) return;
        const max = maxScroll();
        const travel = Math.max(1, root.clientHeight - (thumb as HTMLElement).offsetHeight);
        const y = Math.min(Math.max(0, e.clientY - dragOffset), travel);
        root.scrollTop = (y / travel) * max;
      });
      window.addEventListener("mouseup", () => {
        dragging = false;
        document.body.style.userSelect = "";
      });

      window.addEventListener("scroll", updateThumb, { passive: true });
      window.addEventListener("resize", updateThumb);
      updateThumb();
    </script>
  </body>
</html>
